@startuml
title Алгоритм СМО с дорожками (вариант 17)\nОдин событийный цикл; все альтернативы
skinparam activityArrowColor #45576B
skinparam activityDiamondBackgroundColor #F3F6FA
skinparam activityBackgroundColor #F8FBFE

|Модель / календарь|
start
:Создать источники, приборы, пустой буфер\nинициализировать указатели и статистику;
:Запланировать первые GENERATE_REQUEST\nпо ИЗ1 (экспоненциальный интервал);
while (В календаре есть события?) is (да)
  :Извлечь событие с минимальным временем\nперевести модельное время на event.time;

  if (GENERATE_REQUEST?) then (да)
    |Источник|
    :Создать заявку Request (ИБ);
:Определить следующий интервал\nпо ИЗ1: -ln(1-U)/lambda;
    |Статистика|
    :Учесть сгенерированную заявку;
    |Модель / календарь|
    :Запланировать ROUTE_REQUEST;
    if (Лимит генерации достигнут?) then (нет)
      :Запланировать следующий GENERATE_REQUEST;
    else (да)
      :Прекратить новые генерации;
    endif

  elseif (ROUTE_REQUEST?) then (да)
    |Диспетчер постановки|
    :Принять заявку из события;
    |Менеджер приборов|
:Д2П1: проверить P1, P2, ..., Pm\nпо возрастанию номеров;
    if (Есть свободный прибор?) then (да)
      |Модель / календарь|
:Запланировать START_SERVICE\nдля первого свободного прибора;
    else (все заняты)
      |Модель / календарь|
      :Запланировать PUT_BUFFER;
    endif

  elseif (PUT_BUFFER?) then (да)
    |Диспетчер постановки|
    :Передать заявку в БП;
    |Буфер по кольцу|
    if (Доступна свободная ячейка?) then (да)
      :Д1ОЗ1: искать свободное место от writePointer\nзаписать заявку и сдвинуть указатель по кольцу;
    else (буфер полон)
:Д1ОО4: найти индекс последней\nпоступившей в БП заявки;
      |Модель / календарь|
      :Запланировать DISPLACE_REQUEST;
    endif

  elseif (DISPLACE_REQUEST?) then (да)
    |Буфер по кольцу|
:Д1ОО4: выбить ПОСЛЕДНЮЮ\nпоступившую в буфер заявку;
    |Статистика|
    :Учесть отказ выбитой заявке;
    |Модель / календарь|
    :Запланировать WRITE_REPLACEMENT;

  elseif (WRITE_REPLACEMENT?) then (да)
    |Буфер по кольцу|
    :Записать новую заявку на место выбитой\nобновить writePointer;

  elseif (START_SERVICE?) then (да)
    |Модель / календарь|
:ПЗ2: равномерное время обслуживания\nT = tMin + U*(tMax-tMin);
    |Приборы|
    :start(request, currentTime, duration);
    |Модель / календарь|
:Запланировать SERVICE_FINISH\nна currentTime + duration;

  elseif (SERVICE_FINISH?) then (да)
    |Приборы|
    :finish(currentTime)\nосвободить прибор;
    |Статистика|
:Учесть обслуживание, ожидание,\nобщее время и загрузку;
    |Буфер по кольцу|
    if (В буфере есть заявки?) then (да)
      |Модель / календарь|
:Запланировать SELECT_BUFFER\n(триггер диспетчера выбора);
    else (пуст)
      |Приборы|
      :Прибор остаётся свободным;
    endif

  elseif (SELECT_BUFFER?) then (да)
    |Диспетчер выбора|
    :Обработать событие освобождения;
    |Менеджер приборов|
:Д2П1: найти первый свободный прибор\nпо номеру (P1 ... Pm);
    if (Свободный прибор найден?) then (да)
      |Буфер по кольцу|
      if (В буфере есть заявки?) then (да)
        :Д2Б3: искать занятую ячейку от readPointer\nизвлечь заявку и сдвинуть readPointer по кольцу;
        |Модель / календарь|
        :Запланировать START_SERVICE;
      else (пуст)
        |Диспетчер выбора|
        :Обслуживать нечего;
      endif
    else (все заняты)
      |Диспетчер выбора|
      :Ожидать нового освобождения;
    endif
  endif
  |Модель / календарь|
  :Проверить инварианты модели;
endwhile (нет)
:ОР1 — сводная статистика\nОД2 — формализованное текущее состояние;
stop
@enduml
