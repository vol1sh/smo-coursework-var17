@startuml
autonumber
skinparam BoxPadding 10
skinparam ParticipantPadding 10

title Сиквенс-диаграмма функционирования СМО (Вариант 17)\nФормула: ИБ | ИЗ1 | ПЗ2 | Д1ОЗ1 | Д1ОО4 | Д2П1 | Д2Б3 | ОР1 | ОД2

box "Событийный таймер" #LightYellow
  control "Календарь событий\n(EventCalendar)" as Calendar
end box

box "Входной поток" #LightCyan
  participant "Источник заявок\n(Source ИБ)" as Source
end box

box "Диспетчеризация и память" #LightGreen
  participant "Диспетчер постановки\n(PutDispatcher ДП)" as PutDisp
  participant "Буферная память\n(RingBuffer БП)" as Buffer
  participant "Диспетчер выбора\n(SelectDispatcher ДВ)" as SelDisp
end box

box "Вычислительные приборы" #Lavender
  participant "Менеджер приборов\n(DeviceManager)" as DevMgr
  participant "Прибор П1 (Основной)\n(Device P1)" as Dev1
  participant "Прибор П2 (Вспомог.)\n(Device P2)" as Dev2
end box

box "Аналитика" #MistyRose
  participant "Сборщик статистики\n(StatisticsCollector)" as Stats
end box

== 1. Генерация заявки источником (ИБ, ИЗ1) ==

Calendar -> Source: Наступило событие EVENT_GENERATE_REQUEST(sourceId, currentTime)
activate Source
note over Source
  <b>Закон генерации ИЗ1</b>: Пуассоновский поток.
  Интервал до следующей заявки:
  dt = - (1 / lambda) * ln(R), R in (0, 1)
end note
Source -> Source: Создать Request(id, sourceId, currentTime)
Source -> Calendar: scheduleEvent(EVENT_GENERATE_REQUEST, currentTime + dt)
Calendar -->> Source: ACK (событие запланировано)

Source -> PutDisp: putRequest(request, currentTime)
activate PutDisp
PutDisp -> Stats: recordRequestGenerated(request)
Stats -->> PutDisp: ACK

== 2. Проверка доступности приборов: Дисциплина Д2П1 ==

note over PutDisp, DevMgr
  <b>Дисциплина Д2П1</b>: Приоритет по номеру прибора.
  Поиск свободного прибора всегда ведется строго с П1 к Пm.
end note

PutDisp -> DevMgr: getFreeDeviceByPriority()
activate DevMgr
DevMgr -> Dev1: isBusy()
Dev1 -->> DevMgr: статус (true / false)

alt СЦЕНАРИЙ А [Happy Flow: Прибор П1 свободен]
  DevMgr -->> PutDisp: freeDevice = Device(P1)
  PutDisp -> Dev1: startService(request, currentTime)
  activate Dev1
  note over Dev1
    <b>Закон обслуживания ПЗ2</b>: Равномерный.
    T_service = t_min + R * (t_max - t_min)
  end note
  Dev1 -> Calendar: scheduleEvent(EVENT_SERVICE_FINISH, P1, currentTime + T_service)
  Calendar -->> Dev1: ACK (событие завершения запланировано)
  Dev1 -->> PutDisp: Response(SERVICE_STARTED, P1, finishTime)
  deactivate Dev1
  PutDisp -> Stats: recordDirectService(request, P1)
  Stats -->> PutDisp: ACK
  PutDisp -->> Source: Response(ACCEPTED_DIRECT, P1)

else СЦЕНАРИЙ B [Все приборы заняты -> Обращение в буфер]
  DevMgr -> Dev2: isBusy()
  Dev2 -->> DevMgr: статус = true (занят)
  DevMgr -->> PutDisp: freeDevice = null (все заняты)
  deactivate DevMgr

  == 3. Постановка в буфер: Дисциплина Д1ОЗ1 (по кольцу) ==
  note over PutDisp, Buffer
    <b>Дисциплина Д1ОЗ1</b>: Запись в буфер «по кольцу».
    Поиск свободного места начинается с указателя writePointer.
    Сдвига очереди не происходит.
  end note

  PutDisp -> Buffer: putRequest(request)
  activate Buffer

  alt В буфере есть свободная ячейка
    Buffer -> Buffer: Найти слот начиная с writePointer;\nПоместить заявку в слот;\nwritePointer = (foundSlot + 1) % Capacity
    Buffer -->> PutDisp: Response(ENQUEUED, slotIndex, writePointer)
    PutDisp -> Stats: recordRequestBuffered(request, slotIndex)
    Stats -->> PutDisp: ACK
    PutDisp -->> Source: Response(ACCEPTED_BUFFER, slotIndex)

  else СЦЕНАРИЙ C [Буфер полон -> Дисциплина отказа Д1ОО4]
    note over Buffer
      Буфер переполнен (count == Capacity).
      <b>Дисциплина Д1ОО4</b>: Отказ получает ПОСЛЕДНЯЯ
      поступившая в буфер заявка (самая «свежая» по timeStamp).
      Приборы НЕ отказывают — отказ происходит только в буфере!
    end note
    Buffer -> Buffer: findNewestRequestInBuffer() -> requestToDrop
    Buffer -> Buffer: Заменить requestToDrop на новую заявку;\nОбновить указатель writePointer
    Buffer -->> PutDisp: Response(DISPLACED_SUCCESS, droppedRequest, slotIndex)
    deactivate Buffer

    PutDisp -> Stats: recordRequestDropped(droppedRequest, REASON_DISPLACED_D1OO4)
    Stats -->> PutDisp: ACK
    PutDisp -> Stats: recordRequestBuffered(request, slotIndex)
    Stats -->> PutDisp: ACK
    PutDisp -->> Source: Response(ACCEPTED_WITH_DISPLACEMENT, droppedRequest)
  end
end
deactivate PutDisp
deactivate Source

== 4. Освобождение прибора и выборка из буфера: Дисциплина Д2Б3 ==

Calendar -> Dev1: Наступило событие EVENT_SERVICE_FINISH(P1, currentTime)
activate Dev1
Dev1 -> Stats: recordServiceFinished(finishedRequest, P1, currentTime)
Stats -->> Dev1: ACK
Dev1 -> Dev1: setBusy(false), currentRequest = null
Dev1 -> SelDisp: notifyDeviceFree(P1, currentTime)
activate SelDisp
deactivate Dev1

note over SelDisp, Buffer
  <b>Триггерное событие</b>: Освобождение прибора П1.
  <b>Дисциплина Д2Б3</b>: Выбор заявки из буфера «по кольцу».
  Поиск занятого слота ведется циклически от readPointer.
end note

SelDisp -> Buffer: extractByRing()
activate Buffer

alt Буфер пуст (нет заявок на обслуживание)
  Buffer -->> SelDisp: Response(BUFFER_EMPTY)
  deactivate Buffer
  note over SelDisp, Dev1
    Прибор П1 остается в состоянии ожидания (IDLE).
  end note
  SelDisp -->> Dev1: setStatus(IDLE)

else Буфер содержит заявки
  Buffer -> Buffer: Найти первый занятый слот начиная с readPointer;\nИзвлечь request;\nreadPointer = (foundSlot + 1) % Capacity
  Buffer -->> SelDisp: Response(EXTRACTED, request, readPointer)
  deactivate Buffer

  note over SelDisp, DevMgr
    <b>Дисциплина Д2П1</b>: Назначение заявки на свободный прибор.
    Проверка начинается с П1. Поскольку П1 только что освободился,
    заявка назначается на приоритетный прибор П1.
  end note

  SelDisp -> DevMgr: getFreeDeviceByPriority()
  activate DevMgr
  DevMgr -->> SelDisp: freeDevice = Device(P1)
  deactivate DevMgr

  SelDisp -> Dev1: startService(request, currentTime)
  activate Dev1
  Dev1 -> Calendar: scheduleEvent(EVENT_SERVICE_FINISH, P1, currentTime + T_service)
  Calendar -->> Dev1: ACK
  Dev1 -->> SelDisp: Response(SERVICE_STARTED, P1)
  deactivate Dev1

  SelDisp -> Stats: recordServiceStartedFromBuffer(request, P1)
  Stats -->> SelDisp: ACK
end

deactivate SelDisp
@enduml
