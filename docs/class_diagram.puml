@startuml
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 38
skinparam ranksep 50
hide empty members
title Диаграмма классов СМО (вариант 17)\nРеальные классы и сигнатуры Java-модели Simulation

class Simulation {
  - config: Config
  - random: Random
  - sources: Source[]
  - buffer: RingBuffer
  - manager: DeviceManager
  - eventQueue: PriorityQueue<Event>
  - statistics: StatisticsCollector
  - putDispatcher: PutDispatcher
  - selectDispatcher: SelectDispatcher
  - time: double
  - nextRequestId: int
  - nextEventSerial: long
  + Simulation(config: Config)
  + step(): boolean
  - schedule(type: EventType, at: double, sourceId: int, deviceId: int, slot: int, request: Request): void
  + isFinished(): boolean
  + checkInvariants(): void
}

class Config <<record>> {
  + sources: int
  + devices: int
  + bufferSize: int
  + lambda: double
  + serviceMin: double
  + serviceMax: double
  + maxRequests: int
  + seed: long
}

enum RequestStatus {
  GENERATED
  BUFFERED
  IN_SERVICE
  COMPLETED
  DROPPED_D1OO4
}

enum EventType {
  GENERATE_REQUEST
  ROUTE_REQUEST
  PUT_BUFFER
  DISPLACE_REQUEST
  WRITE_REPLACEMENT
  SELECT_BUFFER
  START_SERVICE
  SERVICE_FINISH
}

class Request {
  - id: int
  - sourceId: int
  - sourceSequence: int
  - generationTime: double
  - bufferEntryTime: double
  - serviceStartTime: double
  - serviceEndTime: double
  - status: RequestStatus
  + getId(): int
  + getSourceId(): int
  + getStatus(): RequestStatus
  + getGenerationTime(): double
  + getBufferEntryTime(): double
  + getServiceStartTime(): double
  + getServiceEndTime(): double
  + waitTime(): double
  + serviceTime(): double
  + totalTime(): double
  + label(): String
}

class Event {
  - type: EventType
  - time: double
  - sourceId: int
  - deviceId: int
  - slot: int
  - request: Request
  - serial: long
  + getType(): EventType
  + getTime(): double
  + subject(): String
  + compareTo(other: Event): int
}

class Source {
  - id: int
  - lambda: double
  - generatedCount: int
  - nextGenerationTime: double
  ~ generateRequest(globalId: int, currentTime: double): Request
  ~ calculateNextInterval(random: Random): double
  + getId(): int
  + getGeneratedCount(): int
  + getNextGenerationTime(): double
}

class RingBuffer {
  - slots: Request[]
  - writePointer: int
  - readPointer: int
  - size: int
  + capacity(): int
  + size(): int
  + isFull(): boolean
  + isEmpty(): boolean
  + getWritePointer(): int
  + getReadPointer(): int
  + get(index: int): Request
  + putRequest(request: Request, time: double): int
  - insertAt(index: int, request: Request, time: double): void
  + findNewestSlot(): int
  + displaceNewest(index: int): Request
  + writeReplacement(index: int, request: Request, time: double): void
  + extractByRing(): Request
}

class Device {
  - id: int
  - currentRequest: Request
  - finishTime: double
  - busyTotal: double
  - servicedCount: int
  + getId(): int
  + isBusy(): boolean
  + getCurrentRequest(): Request
  + getFinishTime(): double
  + getServicedCount(): int
  + utilization(time: double): double
  ~ start(request: Request, start: double, duration: double): void
  ~ finish(time: double): Request
}

class DeviceManager {
  - devices: Device[]
  + getFreeDeviceByPriority(): Device
  + get(id: int): Device
  + all(): List<Device>
  + busyCount(): int
}

class PutDispatcher {
  - buffer: RingBuffer
  - manager: DeviceManager
  - statistics: StatisticsCollector
  ~ putRequest(request: Request): void
  ~ bufferRequest(request: Request): void
  ~ displace(incoming: Request, slot: int): void
  ~ putReplacement(incoming: Request, slot: int): void
}

class SelectDispatcher {
  - buffer: RingBuffer
  - manager: DeviceManager
  ~ selectAfterRelease(): void
}

class StatisticsCollector {
  - generated: int[]
  - dropped: int[]
  - completed: int[]
  - waitTotal: double[]
  - serviceTotal: double[]
  - systemTotal: double[]
  - totalGenerated: int
  - totalDropped: int
  - totalCompleted: int
  ~ recordRequestGenerated(request: Request): void
  ~ recordRequestDropped(request: Request): void
  ~ recordServiceFinished(request: Request): void
  + getTotalGenerated(): int
  + getTotalDropped(): int
  + getTotalCompleted(): int
  + avgWait(index: int): double
  + avgService(index: int): double
  + avgSystem(index: int): double
  + failurePercent(): double
}

Simulation *-- "1" Config
Simulation *-- "1..*" Source : sources[]
Simulation *-- "1" RingBuffer : buffer
Simulation *-- "1" DeviceManager : manager
Simulation *-- "0..*" Event : eventQueue
Simulation *-- "1" StatisticsCollector : statistics
Simulation *-- "1" PutDispatcher : putDispatcher
Simulation *-- "1" SelectDispatcher : selectDispatcher

PutDispatcher --> RingBuffer : buffer
PutDispatcher --> DeviceManager : manager
PutDispatcher --> StatisticsCollector : statistics
SelectDispatcher --> RingBuffer : buffer
SelectDispatcher --> DeviceManager : manager
DeviceManager *-- "1..*" Device : devices[]
RingBuffer o-- "0..*" Request : slots[]
Device --> "0..1" Request : currentRequest
Event --> "0..1" Request : request
Event --> EventType
Request --> RequestStatus

note bottom of Simulation
  В Java эти типы объявлены вложенными в Simulation.
  Календарь событий — поле eventQueue, а не отдельный EventCalendar.
  START_SERVICE и SERVICE_FINISH обрабатывает Simulation.step().
end note
note right of PutDispatcher
  ДП запускается событием ROUTE_REQUEST.
  Может направить заявку сразу на прибор (через START_SERVICE)
  либо в буфер (через PUT_BUFFER).
end note
note right of SelectDispatcher
  ДВ запускается событием SELECT_BUFFER
  после освобождения прибора, если буфер не пуст.
  Сначала выбирает свободный прибор, затем заявку из БП.
end note
@enduml
